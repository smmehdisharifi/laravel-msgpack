{
    "name": "smmehdisharifi/laravel-msgpack",
    "description": "Optional MessagePack content negotiation and binary API responses for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mehdi Sharifi",
            "email": "smmehdisharifi@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "rybakit/msgpack": "^0.7",
        "symfony/http-foundation": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0"
    },
    "suggest": {
        "ext-zlib": "Enables gzip metrics in the msgpack:benchmark command"
    },
    "autoload": {
        "psr-4": {
            "SmMehdiSharifi\\LaravelMsgpack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmMehdiSharifi\\LaravelMsgpack\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SmMehdiSharifi\\LaravelMsgpack\\MsgpackServiceProvider"
            ],
            "aliases": {
                "Msgpack": "SmMehdiSharifi\\LaravelMsgpack\\Facades\\Msgpack"
            }
        }
    },
    "keywords": [
        "laravel",
        "messagepack",
        "msgpack",
        "binary-api",
        "content-negotiation",
        "serialization"
    ],
    "minimum-stability": "stable"
}
